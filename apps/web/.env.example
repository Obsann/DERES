# Frontend Vite env. Copy to .env.local for local overrides.
# Never commit real secrets here.

# Backend origin used by the Vite proxy (and later by the API client).
# Production (Vercel): https://<deres-api>.onrender.com  — no trailing slash.
VITE_API_URL=http://localhost:4000

# Voxide publishable key. Domain-lock it in the Voxide dashboard.
# VITE_VOXIDE_PUBLIC_KEY=vox_pub_...

# Google Maps JavaScript API. Restrict the key by HTTP referrer in Google Cloud.
# VITE_MAPS_API_KEY=

{
  "name": "voicesos",
  "version": "0.1.0",
  "private": true,
  "description": "VoiceSOS - multilingual voice-first AI first-responder system. Team COD1, STARK Hackathon 2026.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace @voicesos/server",
    "dev:web": "npm run dev --workspace @voicesos/web",
    "dev:server": "npm run dev --workspace @voicesos/server",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}

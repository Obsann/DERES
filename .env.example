# VoiceSOS environment template.
# Copy to .env and fill in real values. NEVER commit .env or real credentials.
# Replace placeholder names with the provider's exact variable names once
# the LLM and Voxide providers are selected (task.md section 46).

# Server
NODE_ENV=development
PORT=

# Database (MongoDB Atlas for the MVP - spec section 17)
MONGODB_URI=

# AI provider — OpenAI-compatible Chat Completions (Task 7)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Voice provider
VOXIDE_API_KEY=

# Frontend origin, used for CORS
CLIENT_URL=
